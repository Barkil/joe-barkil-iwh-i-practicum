//- ** This is a sample of a pug template and how it uses the data passed to it from index.js.

doctype html
html
    head
        title= `${title}`
        meta(name="viewport" content="width=device-width, initial-scale=1")
        link(rel="stylesheet", href="/css/style.css")
    body
        h1= `${title}`
        a.update-link(href="/update-cobj") Add to this table
        table
            thead
                tr
                    th Name
                    th Genre
                    th Streaming Service
            tbody
                each show in data
                    tr
                        td= show.properties.name
                        td= show.properties.genre
                        td= show.properties.streaming_service
